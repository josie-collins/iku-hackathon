# Copy to .env and fill in. Never commit .env.

# --- Required ---
# PostgreSQL connection string. Local example: postgresql://localhost:5432/tripplanner
# Hosted databases usually look like: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://localhost:5432/tripplanner
# Long random string for signing login tokens
JWT_SECRET=
# Port the API (and the built frontend) is served on
PORT=8080

# --- Wise: exchange rates ---
# Must match the key: a sandbox key only works on the sandbox URL. Defaults to sandbox if empty.
# Without a working key, every rate is a labelled fallback.
# Sandbox: https://api.wise-sandbox.com   Live: https://api.wise.com
WISE_BASE_URL=https://api.wise-sandbox.com
WISE_API_KEY=

# --- Gemini: receipt reading, spoken-expense parsing, explanations ---
GEMINI_API_KEY=

# --- ElevenLabs: voice expense logging and spoken check-ins ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- SerpApi: live flight prices ---
SERPAPI_KEY=

# --- Snowflake: insights and Cortex reasons (optional; the app falls back to the database) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Either a path to the private key (relative to code/backend) or the PEM itself on one line with \n
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Default: mistral-large2
SNOWFLAKE_CORTEX_MODEL=



