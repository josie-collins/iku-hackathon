PORT=8080

# Postgres / Tiger Data connection string, e.g. postgres://user:pass@host:5432/db
DATABASE_URL=

# Filled in automatically by npm run dev
JWT_SECRET=

# Exchange rates. Without these the app uses labelled fallback rates.
WISE_BASE_URL=https://api.wise-sandbox.com/
WISE_API_KEY=

# Live flight prices (SerpApi Google Flights). Without it, sample estimates are used.
SERPAPI_KEY=

# Receipt and voice parsing. Without it, expenses are entered by hand.
GEMINI_API_KEY=

# Voice entry and read-back. ELEVENLABS_VOICE_ID is optional.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Snowflake analytics (optional). Without these, insights come from Postgres.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
